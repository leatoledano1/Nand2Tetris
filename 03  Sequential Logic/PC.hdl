/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (lc oad[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    // Put your code here:
    Inc16(in=currentVal, out=incrementedVal);
    Mux16(a=currentVal, b=incrementedVal, sel=inc, out=mux1Out);
    Mux16(a=mux1Out, b=in, sel=load, out=mux2Out);
    Or16(a=false, b=false, out=zero);
    Mux16(a=mux2Out, b=zero, sel=reset, out=nextVal);
    Register(in=nextVal, load=true, out=currentVal, out=out);
}
